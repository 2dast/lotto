---
// 리포트 상세 페이지. scripts/report_template.html + generate_report.py를 이식한다.
// 이 페이지는 index.astro/reports/index.astro의 iframe에 임베드되는 leaf 콘텐츠 페이지라
// 대시보드의 오프캔버스 사이드바 레이아웃은 필요 없다 (report_template.html 자체가
// nav 없는 단일 시트 문서였다).
import { getCollection } from "astro:content";
import PredictionTable from "../../../components/PredictionTable.astro";
import RangeChart, { type RangeCondition } from "../../../components/RangeChart.astro";
import DistributionChart from "../../../components/DistributionChart.astro";
import { odd, maxConsecutive, zoneCount } from "../../../components/chartMath";

export async function getStaticPaths() {
  const predictions = await getCollection("predictions");
  return predictions.map((entry) => ({
    params: {
      round: String(entry.data.based_on_drwNo + 1),
      file: entry.data.file.replace(/\.json$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { based_on_drwNo, generated_at, option1, option2 } = entry.data;
const nextRound = based_on_drwNo + 1;

const draws = await getCollection("draws");
const totalDraws = draws.length;

const dateMatch = generated_at.match(/^(\d{4})-(\d{2})-(\d{2})/);
const dateLabel = dateMatch ? `${dateMatch[1]}.${dateMatch[2]}.${dateMatch[3]}` : generated_at;

function maxOverlap(predictions: number[][]): number {
  const counts = new Array(46).fill(0);
  predictions.forEach((combo) => combo.forEach((n) => counts[n]++));
  return Math.max(...counts, 1);
}

const CONDITIONS_OPTION1: RangeCondition[] = [
  { label: "합계", axisMin: 40, axisMax: 250, allowedMin: 88, allowedMax: 189,
    value: (combo) => combo.reduce((a, b) => a + b, 0) },
  { label: "홀수 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 5,
    value: (combo) => odd(combo) },
  { label: "최대 연속", axisMin: 1, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => maxConsecutive(combo) },
  { label: "1-9구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 1, 9) },
  { label: "10-19구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 10, 19) },
  { label: "20-29구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 20, 29) },
  { label: "30-39구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 30, 39) },
  { label: "40-45구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 2,
    value: (combo) => zoneCount(combo, 40, 45) },
];

const CONDITIONS_OPTION2: RangeCondition[] = [
  { label: "합계", axisMin: 40, axisMax: 250, allowedMin: 88, allowedMax: 189,
    value: (combo) => combo.reduce((a, b) => a + b, 0) },
  { label: "홀수 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 5,
    value: (combo) => odd(combo) },
  { label: "최대 연속", axisMin: 1, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => maxConsecutive(combo) },
  { label: "1-9구간 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => zoneCount(combo, 1, 9) },
  { label: "10-19구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 10, 19) },
  { label: "20-29구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 20, 29) },
  { label: "30-39구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 30, 39) },
  { label: "40-45구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 0,
    value: (combo) => zoneCount(combo, 40, 45) },
];

const numSets1 = option1.predictions.length;
const overlap1 = maxOverlap(option1.predictions);
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{nextRound}회차 로또 추천 번호 스크리닝 리포트</title>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style is:global>
/* is:global: PredictionTable/RangeChart/DistributionChart (T10) render markup that Astro's
   default scoped styles cannot reach (scoping only applies within the .astro file that
   declares the <style> block, not to child-component output). This page's styles are only
   loaded on this route, so making the whole block global doesn't leak into other pages. */
.viz-root{
  color-scheme: light;
  --bg:            #f4f3ee;
  --paper:         #fffefb;
  --surface-2:     #ecebe3;
  --border:        #d8d6c8;
  --rule:          #1c1c1c;
  --text-primary:  #1c1c1c;
  --text-secondary:#4d4c45;
  --text-muted:    #8a8878;
  --navy:          #1f3a5f;
  --navy-soft:     #e4e9ef;
  --up:            #a5322b;
  --down:          #1f5f4a;
  --band:          #ded9c4;
  --set-1: #2a78d6; --set-2: #eb6834; --set-3: #1baf7a; --set-4: #eda100; --set-5: #e87ba4;
  --set-6: #4a3aa7; --set-7: #008300; --set-8: #e34948;
}
@media (prefers-color-scheme: dark) {
  .viz-root{
    color-scheme: dark;
    --bg:            #16171a;
    --paper:         #1d1e21;
    --surface-2:     #232428;
    --border:        #35363a;
    --rule:          #e8e7e2;
    --text-primary:  #ecebe6;
    --text-secondary:#b7b6ac;
    --text-muted:    #85847a;
    --navy:          #6f8fb8;
    --navy-soft:     #24344a;
    --up:            #d9736b;
    --down:          #4fa688;
    --band:          #4a463c;
    --set-1: #3987e5; --set-2: #d95926; --set-3: #199e70; --set-4: #c98500; --set-5: #d55181;
    --set-6: #9085e9; --set-7: #008300; --set-8: #e66767;
  }
}

* { box-sizing: border-box; }
body { margin: 0; }
.viz-root {
  background: var(--bg);
  font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-primary);
  max-width: 860px;
  margin: 0 auto;
  padding: 32px 20px 60px;
  font-size: 13px;
  line-height: 1.6;
}
.sheet {
  background: var(--paper);
  border: 1px solid var(--border);
  padding: 28px 36px 20px;
}
@media (max-width: 560px) {
  .viz-root { padding: 20px 12px 40px; }
  .sheet { padding: 20px 16px 16px; }
}

.masthead {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-bottom: 3px double var(--rule);
  padding-bottom: 8px;
  margin-bottom: 14px;
}
.firm {
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.02em;
}
.firm span { color: var(--navy); }
.doc-meta {
  text-align: right;
  font-size: 11px;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.kicker {
  font-size: 11px;
  color: var(--navy);
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}
h1 {
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.01em;
  margin: 0 0 8px;
  text-wrap: balance;
}
.subtitle {
  color: var(--text-secondary);
  font-size: 13px;
  margin: 0 0 16px;
  max-width: 68ch;
}
.byline {
  display: flex;
  gap: 20px;
  font-size: 11px;
  color: var(--text-muted);
  border-bottom: 1px solid var(--rule);
  padding-bottom: 14px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.byline b { color: var(--text-primary); font-weight: 500; }

.rating-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  border: 1px solid var(--border);
  margin-bottom: 24px;
}
.rating-box {
  flex: none;
  width: 128px;
  background: var(--navy-soft);
  color: var(--navy);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px 8px;
  border-right: 1px solid var(--border);
  text-align: center;
}
.rating-box .r-label { font-size: 10px; color: var(--text-muted); margin-bottom: 3px; }
.rating-box .r-value { font-weight: 700; font-size: 15px; }
.key-figures {
  flex: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
@media (max-width: 560px) {
  .rating-strip { flex-direction: column; }
  .rating-box { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
  .key-figures { grid-template-columns: repeat(2, 1fr); }
  .kf:nth-child(2) { border-right: none; }
}
.table-scroll { overflow-x: auto; }
.kf {
  padding: 9px 14px;
  border-right: 1px solid var(--border);
}
.kf:last-child { border-right: none; }
.kf .kf-label { font-size: 10px; color: var(--text-muted); margin-bottom: 2px; }
.kf .kf-value { font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }

.summary-box {
  background: var(--surface-2);
  border-left: 3px solid var(--navy);
  padding: 12px 16px;
  font-size: 12.5px;
  line-height: 1.65;
  margin-bottom: 28px;
}
.summary-box b { color: var(--navy); }

section { margin-bottom: 30px; }
h2 {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 3px;
  padding-bottom: 6px;
  border-bottom: 1.5px solid var(--rule);
  display: flex;
  align-items: baseline;
  gap: 6px;
}
h2 .roman { color: var(--navy); font-size: 13px; }
.section-desc {
  font-size: 12px;
  color: var(--text-secondary);
  margin: 6px 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.chart-note {
  font-size: 11px;
  color: var(--text-muted);
  margin: 10px 0 0;
  max-width: 68ch;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
thead tr { border-bottom: 1px solid var(--rule); }
tbody tr:last-child td { border-bottom: 1.5px solid var(--rule); }
th, td {
  text-align: left;
  padding: 7px 10px;
  border-bottom: 1px solid var(--border);
}
th {
  color: var(--text-muted);
  font-weight: 700;
  font-size: 10.5px;
  letter-spacing: 0.02em;
}
td.num { font-variant-numeric: tabular-nums; text-align: right; color: var(--text-primary); }
td.new { color: var(--down); font-weight: 700; }

.combo-numbers { display: flex; flex-wrap: wrap; gap: 5px; }
.ball {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  font-weight: 700;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  color: #fff;
}

svg text { fill: var(--text-secondary); font-size: 10px; font-family: inherit; }
svg .axis-line { stroke: var(--rule); stroke-width: 1; }

.range-charts { display: flex; flex-direction: column; gap: 8px; }
.range-track { fill: var(--surface-2); }
.range-allowed { fill: var(--band); }
.range-set-label { font-size: 9px; font-weight: 700; }
.range-legend {
  display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px;
  font-size: 11px; color: var(--text-secondary);
}
.range-legend-item { display: flex; align-items: center; gap: 5px; }
.range-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }

.disclaimer {
  color: var(--text-muted);
  font-size: 10.5px;
  border-top: 3px double var(--rule);
  padding-top: 14px;
  margin-top: 8px;
  line-height: 1.7;
}
.disclaimer p { margin: 0 0 6px; }
</style>
</head>
<body>
<div class="viz-root">
<div class="sheet">

  <div class="masthead">
    <div class="firm">2dast <span>Data Research</span></div>
    <div class="doc-meta">Report No. LOT-2026-01 &nbsp;·&nbsp; <span>{dateLabel}</span></div>
  </div>

  <div class="kicker">DATA ANALYSIS &nbsp;/&nbsp; 통계 분석 자료</div>
  <h1>로또 6/45 추천 번호 스크리닝 리포트</h1>
  <p class="subtitle"><span>{based_on_drwNo}</span>회차까지 당첨 데이터로 보정한 스크리닝 조건과, 이를 통과한 <span>{nextRound}</span>회차 추천 세트</p>
  <div class="byline">
    <span>기준회차: <b><span>{based_on_drwNo}</span>회 (차기 예측)</b></span>
    <span>분류: <b>참고자료 · 투자권유 아님</b></span>
  </div>

  <div class="rating-strip">
    <div class="rating-box">
      <div class="r-label">종합 판단</div>
      <div class="r-value">참고용</div>
    </div>
    <div class="key-figures">
      <div class="kf"><div class="kf-label">분석 회차</div><div class="kf-value"><span>{totalDraws.toLocaleString()}</span>회</div></div>
      <div class="kf"><div class="kf-label">예측 회차</div><div class="kf-value"><span>{nextRound}</span>회</div></div>
      <div class="kf"><div class="kf-label">추천 세트</div><div class="kf-value"><span>{numSets1}</span>건</div></div>
      <div class="kf"><div class="kf-label">최대 중복</div><div class="kf-value"><span>{overlap1}</span>개 세트</div></div>
    </div>
  </div>

  <div class="summary-box">
    <b>Summary —</b> 이 리포트는 <span>{nextRound}</span>회차 추천 <span>{numSets1}</span>세트가
    <b>왜 이 번호들로 구성됐는지</b>를 설명하는 문서다. 로또는 회차마다 독립적으로 추첨되어 과거 데이터가
    다음 회차의 당첨 확률 자체를 바꾸지 못하므로, 아래 내용은 "당첨 확률이 높다"는 뜻이 아니라
    <b>스크리닝 조건(Ⅳ장 참고)을 만족하도록 생성된 조합의 상세 내역</b>이다.
  </div>

  <section>
    <h2><span class="roman">Ⅰ.</span> <span>{nextRound}</span>회차 추천 세트</h2>
    <p class="section-desc">세트별 번호와 핵심 수치</p>
    <PredictionTable predictions={option1.predictions} />
    <p class="chart-note">※ 구간분포는 1-9·10-19·20-29·30-39·40-45 순서로 각 구간에 포함된 번호 개수다.</p>
  </section>

  <section>
    <h2><span class="roman">Ⅱ.</span> 왜 이 번호들인가 — 조건별 허용범위 대비 위치</h2>
    <p class="section-desc">조건별 허용범위 대비 각 세트의 실제 값</p>
    <RangeChart predictions={option1.predictions} conditions={CONDITIONS_OPTION1} />
    <p class="chart-note">※ 회색 막대 = 조건별 허용범위, 점 = 각 세트의 실제 값. 점이 막대 안에 있으면 그 조건을 통과했다는 뜻이다.</p>
  </section>

  <section>
    <h2><span class="roman">Ⅲ.</span> 번호 분포</h2>
    <p class="section-desc">번호별 등장 횟수</p>
    <DistributionChart predictions={option1.predictions} />
    <p class="chart-note">※ 가로축은 번호(1~45), 세로축은 추천 5세트 중 그 번호가 뽑힌 횟수다. 점이 2개 이상 쌓이면 여러 세트에서 중복 선택된 번호다. 색상은 공식 번호 구간 색상(1-10 노랑 · 11-20 파랑 · 21-30 빨강 · 31-40 회색 · 41-45 초록)을 따른다.</p>
  </section>

  <section>
    <h2><span class="roman">Ⅳ.</span> 조건의 근거</h2>
    <p class="section-desc">조건이 왜 이 값인지의 근거</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>조건</th><th>값</th><th style="text-align:right">근거</th></tr></thead>
        <tbody>
          <tr><td>odd_even (홀수 개수)</td><td class="new">1 5</td><td class="num">5~95pct</td></tr>
          <tr><td>sum (6개 합계)</td><td class="new">88 189</td><td class="num">5~95pct</td></tr>
          <tr><td>consecutive_max (최대 연속)</td><td class="new">3</td><td class="num">95pct</td></tr>
          <tr><td>zone 1-9 (구간 개수)</td><td class="new">min 0 max 3</td><td class="num">5~95pct</td></tr>
          <tr><td>zone 10-19 (구간 개수)</td><td class="new">min 0 max 3</td><td class="num">5~95pct</td></tr>
          <tr><td>zone 20-29 (구간 개수)</td><td class="new">min 0 max 3</td><td class="num">5~95pct</td></tr>
          <tr><td>zone 30-39 (구간 개수)</td><td class="new">min 0 max 3</td><td class="num">5~95pct</td></tr>
          <tr><td>zone 40-45 (구간 개수)</td><td class="new">min 0 max 2</td><td class="num">평균 0.80개</td></tr>
        </tbody>
      </table>
    </div>
    <p class="chart-note">※ 1~<span>{totalDraws}</span>회차 실제 당첨 데이터를 percentile 분석해 고정한 값이다. 회차가 새로 추가돼도 이 값 자체는 재보정 전까지 그대로 유지된다.</p>
  </section>

  {option2 && (
    <div>
      <div class="kicker" style="margin-top:6px">DATA ANALYSIS &nbsp;/&nbsp; 2안 — 1안과 반대 방향 베팅</div>
      <h1 style="font-size:19px">2안 추천 세트</h1>
      <p class="subtitle">RULES_2.md 기준. 1안과 상관관계를 낮추기 위해 40-45구간 배제·1-9구간 강제·콜드넘버 우대 조건을 적용한 별도 세트.</p>

      <section>
        <h2><span class="roman">Ⅰ.</span> 2안 추천 세트</h2>
        <p class="section-desc">세트별 번호와 핵심 수치</p>
        <PredictionTable predictions={option2.predictions} />
        <p class="chart-note">※ 구간분포는 1-9·10-19·20-29·30-39·40-45 순서로 각 구간에 포함된 번호 개수다.</p>
      </section>

      <section>
        <h2><span class="roman">Ⅱ.</span> 왜 이 번호들인가 — 조건별 허용범위 대비 위치</h2>
        <p class="section-desc">조건별 허용범위 대비 각 세트의 실제 값</p>
        <RangeChart predictions={option2.predictions} conditions={CONDITIONS_OPTION2} />
        <p class="chart-note">※ 회색 막대 = 조건별 허용범위, 점 = 각 세트의 실제 값. 점이 막대 안에 있으면 그 조건을 통과했다는 뜻이다.</p>
      </section>

      <section>
        <h2><span class="roman">Ⅲ.</span> 번호 분포</h2>
        <p class="section-desc">번호별 등장 횟수</p>
        <DistributionChart predictions={option2.predictions} />
        <p class="chart-note">※ 가로축은 번호(1~45), 세로축은 2안 추천 세트 중 그 번호가 뽑힌 횟수다. 색상은 공식 번호 구간 색상을 따른다.</p>
      </section>

      <section>
        <h2><span class="roman">Ⅳ.</span> 조건의 근거</h2>
        <p class="section-desc">1안과 다른 조건만 표시 — 그 외(홀짝·합계·최대연속·중간구간)는 1안과 동일</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>조건</th><th>값</th><th style="text-align:right">비고</th></tr></thead>
            <tbody>
              <tr><td>zone 1-9 (구간 개수)</td><td class="new">min 1 max 3</td><td class="num">1안 대비 강제 포함</td></tr>
              <tr><td>zone 40-45 (구간 개수)</td><td class="new">min 0 max 0</td><td class="num">1안 대비 완전 배제</td></tr>
              <tr><td>freq_mode</td><td class="new">cold</td><td class="num">1안(hot)과 반대로 콜드넘버 우대</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  )}

