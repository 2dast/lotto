---
// 리포트 상세 페이지. scripts/report_template.html + generate_report.py를 이식한다.
// 이 페이지는 index.astro/reports/index.astro의 iframe에 임베드되는 leaf 콘텐츠 페이지라
// 대시보드의 오프캔버스 사이드바 레이아웃은 필요 없다 (report_template.html 자체가
// nav 없는 단일 시트 문서였다).
import { getCollection } from "astro:content";
import PredictionTable from "../../../components/PredictionTable.astro";
import type { RangeCondition } from "../../../components/RangeChart.astro";
import { odd, maxConsecutive, zoneCount } from "../../../components/chartMath";

export async function getStaticPaths() {
  const predictions = await getCollection("predictions");
  return predictions.map((entry) => ({
    params: {
      round: String(entry.data.based_on_drwNo + 1),
      file: entry.data.file.replace(/\.json$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { based_on_drwNo, generated_at, option1, option2, option3 } = entry.data;
const nextRound = based_on_drwNo + 1;

const dateMatch = generated_at.match(/^(\d{4})-(\d{2})-(\d{2})/);
const dateLabel = dateMatch ? `${dateMatch[1]}.${dateMatch[2]}.${dateMatch[3]}` : generated_at;

const CONDITIONS_OPTION1: RangeCondition[] = [
  { label: "합계", axisMin: 40, axisMax: 250, allowedMin: 88, allowedMax: 189,
    value: (combo) => combo.reduce((a, b) => a + b, 0) },
  { label: "홀수 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 5,
    value: (combo) => odd(combo) },
  { label: "최대 연속", axisMin: 1, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => maxConsecutive(combo) },
  { label: "1-9구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 1, 9) },
  { label: "10-19구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 10, 19) },
  { label: "20-29구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 20, 29) },
  { label: "30-39구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 30, 39) },
  { label: "40-45구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 2,
    value: (combo) => zoneCount(combo, 40, 45) },
];

const CONDITIONS_OPTION3: RangeCondition[] = [
  { label: "합계", axisMin: 40, axisMax: 250, allowedMin: 88, allowedMax: 189,
    value: (combo) => combo.reduce((a, b) => a + b, 0) },
  { label: "홀수 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 5,
    value: (combo) => odd(combo) },
  { label: "최대 연속", axisMin: 1, axisMax: 6, allowedMin: 1, allowedMax: 2,
    value: (combo) => maxConsecutive(combo) },
  { label: "1-31 구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 4,
    value: (combo) => zoneCount(combo, 1, 31) },
  { label: "32-45 구간 개수", axisMin: 0, axisMax: 6, allowedMin: 2, allowedMax: 6,
    value: (combo) => zoneCount(combo, 32, 45) },
];

const CONDITIONS_OPTION2: RangeCondition[] = [
  { label: "합계", axisMin: 40, axisMax: 250, allowedMin: 88, allowedMax: 189,
    value: (combo) => combo.reduce((a, b) => a + b, 0) },
  { label: "홀수 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 5,
    value: (combo) => odd(combo) },
  { label: "최대 연속", axisMin: 1, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => maxConsecutive(combo) },
  { label: "1-9구간 개수", axisMin: 0, axisMax: 6, allowedMin: 1, allowedMax: 3,
    value: (combo) => zoneCount(combo, 1, 9) },
  { label: "10-19구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 10, 19) },
  { label: "20-29구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 20, 29) },
  { label: "30-39구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 3,
    value: (combo) => zoneCount(combo, 30, 39) },
  { label: "40-45구간 개수", axisMin: 0, axisMax: 6, allowedMin: 0, allowedMax: 0,
    value: (combo) => zoneCount(combo, 40, 45) },
];

// 조건 비교 표: 안별 허용 범위(min~max). 해당 안에서 쓰지 않는 조건은 "—"로 표시한다.
const OPTION_CONDITIONS = [CONDITIONS_OPTION1, CONDITIONS_OPTION2, CONDITIONS_OPTION3];
const COMPARISON_LABELS = [
  "합계", "홀수 개수", "최대 연속",
  "1-9구간 개수", "10-19구간 개수", "20-29구간 개수", "30-39구간 개수", "40-45구간 개수",
  "1-31 구간 개수", "32-45 구간 개수",
];
function allowedText(conditions: RangeCondition[], label: string): string {
  const c = conditions.find((x) => x.label === label);
  return c ? `${c.allowedMin}~${c.allowedMax}` : "—";
}
const comparisonRows = COMPARISON_LABELS.map((label) => ({
  label,
  values: OPTION_CONDITIONS.map((conditions) => allowedText(conditions, label)),
}));

const recommendedSets = [
  { name: "1안", desc: "과거 당첨 데이터의 5~95 백분위 조건과 빈도 상위 번호 우대를 적용한 기본 세트.",
    predictions: option1.predictions },
  { name: "2안", desc: "1안과 상관관계를 낮추기 위해 40-45구간 배제·1-9구간 강제·콜드넘버 우대 조건을 적용한 세트.",
    predictions: option2?.predictions ?? null },
  { name: "3안", desc: "생일 번호(1~31) 쏠림을 줄이고 연속 번호를 피하는 조건을 적용한 세트.",
    predictions: option3?.predictions ?? null },
];
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{nextRound}회차 추천 세트 비교</title>
<script is:inline>
(function () {
  try {
    const saved = localStorage.getItem("lotto-theme");
    if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
  } catch (e) {}
})();
</script>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style is:global>
/* is:global: PredictionTable (T10) renders markup that Astro's
   default scoped styles cannot reach (scoping only applies within the .astro file that
   declares the <style> block, not to child-component output). This page's styles are only
   loaded on this route, so making the whole block global doesn't leak into other pages. */
.viz-root{
  color-scheme: light;
  --bg:            #f4f3ee;
  --paper:         #fffefb;
  --surface-2:     #ecebe3;
  --border:        #d8d6c8;
  --rule:          #1c1c1c;
  --text-primary:  #1c1c1c;
  --text-secondary:#4d4c45;
  --text-muted:    #8a8878;
  --navy:          #1f3a5f;
  --navy-soft:     #e4e9ef;
  --up:            #a5322b;
  --down:          #1f5f4a;
  --band:          #ded9c4;
  --set-1: #2a78d6; --set-2: #eb6834; --set-3: #1baf7a; --set-4: #eda100; --set-5: #e87ba4;
  --set-6: #4a3aa7; --set-7: #008300; --set-8: #e34948;
}
/* 다크 토큰: 사용자가 data-theme="dark"를 골랐거나, 테마를 고르지 않았고 OS가 다크일 때 적용한다.
   data-theme="light"이면 OS 설정과 무관하게 라이트 토큰을 쓴다. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .viz-root{
    color-scheme: dark;
    --bg:            #16171a;
    --paper:         #1d1e21;
    --surface-2:     #232428;
    --border:        #35363a;
    --rule:          #e8e7e2;
    --text-primary:  #ecebe6;
    --text-secondary:#b7b6ac;
    --text-muted:    #85847a;
    --navy:          #6f8fb8;
    --navy-soft:     #24344a;
    --up:            #d9736b;
    --down:          #4fa688;
    --band:          #4a463c;
    --set-1: #3987e5; --set-2: #d95926; --set-3: #199e70; --set-4: #c98500; --set-5: #d55181;
    --set-6: #9085e9; --set-7: #008300; --set-8: #e66767;
  }
}
:root[data-theme="dark"] .viz-root{
  color-scheme: dark;
  --bg:            #16171a;
  --paper:         #1d1e21;
  --surface-2:     #232428;
  --border:        #35363a;
  --rule:          #e8e7e2;
  --text-primary:  #ecebe6;
  --text-secondary:#b7b6ac;
  --text-muted:    #85847a;
  --navy:          #6f8fb8;
  --navy-soft:     #24344a;
  --up:            #d9736b;
  --down:          #4fa688;
  --band:          #4a463c;
  --set-1: #3987e5; --set-2: #d95926; --set-3: #199e70; --set-4: #c98500; --set-5: #d55181;
  --set-6: #9085e9; --set-7: #008300; --set-8: #e66767;
}

* { box-sizing: border-box; }
body { margin: 0; background: #f4f3ee; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) body { background: #16171a; }
}
:root[data-theme="dark"] body { background: #16171a; }
.viz-root {
  background: var(--bg);
  font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-primary);
  max-width: 860px;
  margin: 0 auto;
  padding: 32px 20px 60px;
  font-size: 13px;
  line-height: 1.6;
}
.sheet {
  background: var(--paper);
  border: 1px solid var(--border);
  padding: 28px 36px 20px;
}
@media (max-width: 560px) {
  .viz-root { padding: 20px 12px 40px; }
  .sheet { padding: 20px 16px 16px; }
}

.masthead {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-bottom: 3px double var(--rule);
  padding-bottom: 8px;
  margin-bottom: 14px;
}
.firm {
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.02em;
}
.firm span { color: var(--navy); }
.doc-meta {
  text-align: right;
  font-size: 11px;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.kicker {
  font-size: 11px;
  color: var(--navy);
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}
h1 {
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.01em;
  margin: 0 0 8px;
  text-wrap: balance;
}
.subtitle {
  color: var(--text-secondary);
  font-size: 13px;
  margin: 0 0 16px;
  max-width: 68ch;
}
.table-scroll { overflow-x: auto; }
section { margin-bottom: 30px; }
.option-block { margin-top: 18px; }
h2, h3 {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 3px;
  padding-bottom: 6px;
  border-bottom: 1.5px solid var(--rule);
  display: flex;
  align-items: baseline;
  gap: 6px;
}
h2 .roman, h3 .roman { color: var(--navy); font-size: 13px; }
.section-desc {
  font-size: 12px;
  color: var(--text-secondary);
  margin: 6px 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.chart-note {
  font-size: 11px;
  color: var(--text-muted);
  margin: 10px 0 0;
  max-width: 68ch;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
thead tr { border-bottom: 1px solid var(--rule); }
tbody tr:last-child td { border-bottom: 1.5px solid var(--rule); }
th, td {
  text-align: left;
  padding: 7px 10px;
  border-bottom: 1px solid var(--border);
}
th {
  color: var(--text-muted);
  font-weight: 700;
  font-size: 10.5px;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
td.num { font-variant-numeric: tabular-nums; text-align: right; color: var(--text-primary); }

.combo-numbers { display: flex; flex-wrap: wrap; gap: 5px; }
.ball {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  font-weight: 700;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  color: #fff;
}

.disclaimer {
  color: var(--text-muted);
  font-size: 10.5px;
  border-top: 3px double var(--rule);
  padding-top: 14px;
  margin-top: 8px;
  line-height: 1.7;
}
.disclaimer p { margin: 0 0 6px; }
</style>
</head>
<body>
<div class="viz-root">
<div class="sheet">

  <div class="masthead">
    <div class="firm">2dast <span>Data Research</span></div>
    <div class="doc-meta">Report No. LOT-2026-01 &nbsp;·&nbsp; <span>{dateLabel}</span></div>
  </div>

  <div class="kicker">DATA ANALYSIS &nbsp;/&nbsp; 추천 세트 비교</div>
  <h1>추천 세트 비교</h1>
  <p class="subtitle"><span>{nextRound}</span>회차 예측 · 기준 데이터 <span>{based_on_drwNo}</span>회차</p>

  <section>
    <h2><span class="roman">Ⅰ.</span> 조건 비교</h2>
    <p class="section-desc">안별로 적용한 조건의 허용 범위</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">조건</th><th scope="col" style="text-align:right">1안</th><th scope="col" style="text-align:right">2안</th><th scope="col" style="text-align:right">3안</th></tr></thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((v) => <td class="num">{v}</td>)}
            </tr>
          ))}
          <tr>
            <th scope="row">번호 선택</th>
            <td class="num">빈도 상위 우대</td>
            <td class="num">콜드넘버 우대</td>
            <td class="num">빈도 미반영(균등)</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="chart-note">※ 값은 허용 범위(최소~최대)이고, "—"는 그 안에서 쓰지 않는 조건이다.</p>
  </section>

  <section>
    <h2><span class="roman">Ⅱ.</span> 추천 세트</h2>
    <p class="section-desc">안별 추천 세트와 핵심 수치</p>
    {recommendedSets.map((set) => (
      <div class="option-block">
        <h3>{set.name}</h3>
        <p class="chart-note">{set.desc}</p>
        {set.predictions ? (
          <PredictionTable predictions={set.predictions} />
        ) : (
          <p class="chart-note">이 파일에는 {set.name} 예측이 없습니다.</p>
        )}
      </div>
    ))}
    <p class="chart-note">※ 구간분포는 1-9·10-19·20-29·30-39·40-45 순서로 각 구간에 포함된 번호 개수다.</p>
  </section>

  <div class="disclaimer">
    <p><b>Disclaimer.</b> 본 자료는 로또 6/45 과거 당첨 데이터의 통계적 분포를 정리한 참고자료로, 향후 당첨 확률을 예측하거나 보장하지 않는다.
    로또는 매 회차 독립시행이며, 과거 출현 빈도·패턴은 다음 회차의 개별 번호 당첨 확률에 어떠한 영향도 주지 않는다(도박사의 오류 참고).
    위 표의 조건 범위는 스크리닝 필터 기준일 뿐, 당첨 가능성과는 무관하다.</p>
  </div>

</div>
</div>
</body>
</html>
